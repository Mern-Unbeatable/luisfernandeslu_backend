        {
          "name": "Forgot Password",
          "item": [
            {
              "name": "1. Forgot Password (Send OTP)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer@test.local\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/forgot-password",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "forgot-password"]
                },
                "description": "Sends a 5-digit OTP to the email if an account exists. Same response whether or not the email is registered."
              },
              "response": []
            },
            {
              "name": "2. Verify Reset OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer@test.local\",\n  \"otp\": \"23541\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/verify-reset-otp",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "verify-reset-otp"]
                },
                "description": "Validates the 5-digit reset OTP and returns a short-lived resetToken (10m). OTP is kept until reset-password."
              },
              "response": []
            },
            {
              "name": "3. Reset Password (with resetToken)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"password\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/reset-password",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "reset-password"]
                },
                "description": "Preferred after verify-reset-otp. Password min 8 chars."
              },
              "response": []
            },
            {
              "name": "3b. Reset Password (email + OTP)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer@test.local\",\n  \"otp\": \"23541\",\n  \"password\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/reset-password",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "reset-password"]
                },
                "description": "Alternative: skip verify-reset-otp and send email + OTP + new password in one step."
              },
              "response": []
            }
          ]
