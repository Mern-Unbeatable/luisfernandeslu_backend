        {
          "name": "OTP",
          "item": [
            {
              "name": "Verify Email OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer@test.local\",\n  \"otp\": \"23541\",\n  \"role\": \"customer\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/verify-otp",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "verify-otp"]
                },
                "description": "5-digit OTP after customer/company email register (not Google/Facebook). Check email or server console if SMTP falls back."
              },
              "response": []
            },
            {
              "name": "Resend Email OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer@test.local\",\n  \"role\": \"customer\"\n}"
                },
                "url": {
