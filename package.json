{
    "name": "Welcome to the CONSTRUPRECO API",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=9.0.0"
    },
    "description": "",
    "main": "src/server.js",
    "scripts": {
        "postinstall": "prisma generate",
        "start": "prisma generate && prisma migrate deploy && tsx src/server.js",
        "dev": "tsx --watch src/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "seed:admin": "tsx src/scripts/seed-admin.js",
        "seed:catalog": "tsx src/scripts/seed-catalog.js",
        "seed:promotion-plans": "tsx src/scripts/seed-promotion-plans.js",
        "seed:demo": "tsx src/scripts/seed-demo.js",
        "seed:admin-products": "tsx src/scripts/seed-admin-products.js",
        "seed": "tsx src/scripts/seed-catalog.js && tsx src/scripts/seed-promotion-plans.js && tsx src/scripts/seed-demo.js",
        "test": "node --test tests/**/*.test.js",
        "check:imports": "tsx scripts/check-imports.mjs",
        "test:watch": "node --test --watch tests/**/*.test.js",
        "api:snapshot": "node scripts/api-snapshot.mjs capture",
        "api:diff": "node scripts/api-snapshot.mjs diff"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcrypt": "^6.0.0",
        "better-auth": "^1.6.29",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "5.2.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.5",
        "pdfkit": "^0.19.1",
        "pg": "^8.23.0",
        "prisma": "^7.9.1",
        "socket.io": "^4.8.3",
        "tsx": "^4.23.12",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/multer": "^2.2.0",
        "@types/pdfkit": "^0.17.6",
        "nodemon": "3.1.14"
    }
}