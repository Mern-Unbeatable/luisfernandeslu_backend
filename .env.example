# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"

# JWT access token (login / protected APIs)
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=10m

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Socket.IO (live quote chat) — same origin as API, path /socket.io
# Client: io(API_URL, { auth: { token: accessToken } })

# Social providers (customer & company only) — leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Admin seed (pnpm seed:admin)
ADMIN_EMAIL=admin@construpreco.local
ADMIN_PASSWORD=AdminDemo123!
ADMIN_NAME=Platform Admin

# SMTP Configuration (Gmail: host must be smtp.gmail.com + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# AI product copy (USE AI buttons)
# Production (NODE_ENV=production): Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fast product-copy model (avoid gemini-flash-latest — heavy default thinking)
GEMINI_MODEL=gemini-3.5-flash-lite
# Development: OpenRouter free/dev models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Optional fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cart / checkout totals
# CART_SHIPPING_FEE is legacy/unused — shipping = distance × admin vehicleRates (see /api/admin/settings)
CART_SHIPPING_FEE=0
CART_VAT_FIXED=4
CART_CURRENCY=EUR

# Shipment auction duration (minutes) — fallback before admin settings saved
AUCTION_DURATION_MINUTES=2
# After auction ends, keep it on transporter auction list for this many minutes
AUCTION_ENDED_VISIBLE_MINUTES=5

# Fallback per-km rate before admin vehicleRates are saved
TRANSPORT_PRICE_PER_KM=2.5

# Mapbox (geocoding + driving distance for auctions)
# https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Payment provider: mock (no EuPago) | eupago (real split)
# mock → POST /api/checkout/:id/pay to confirm payment
# eupago → needs Construpreço API key + extern key (admin profile or env) + each seller's eupagoExternKey
# Construpreço is sent as a beneficiary for its commission; beneficiaries must sum to the total.
PAYMENT_PROVIDER=mock

# EuPago Split Payments (used when PAYMENT_PROVIDER=eupago)
# Production: EUPAGO_BASE_URL=https://clientes.eupago.pt/api
EUPAGO_API_KEY=
# Construpreço beneficiary key (fallback when the admin profile has none)
EUPAGO_ADMIN_EXTERN_KEY=
EUPAGO_BASE_URL=https://sandbox.eupago.pt/api
EUPAGO_CALLBACK_URL=http://localhost:8080/api/checkout/webhook/eupago
EUPAGO_WEBHOOK_SECRET=

# InvoiceXpress — certified invoices reported to the Tax Authority (AT)
# Account name + API key: https://www.app.invoicexpress.com/users/api
INVOICEXPRESS_ACCOUNT_NAME=
INVOICEXPRESS_API_KEY=
# false = drafts only (safe for testing, nothing reaches AT); true = finalize + report to AT
INVOICEXPRESS_FINALIZE=false
# true = InvoiceXpress emails the finalized invoice to the buyer
INVOICEXPRESS_SEND_EMAIL=false
# invoice_receipts (Fatura-Recibo, paid sales) | invoices | simplified_invoices
INVOICEXPRESS_DOCUMENT_TYPE=invoice_receipts
# IVA exemption code, only needed if orders can have 0% VAT (e.g. M07)
INVOICEXPRESS_TAX_EXEMPTION_CODE=
ADMIN_COMMISSION_PERCENT=20
EUPAGO_LANG=PT
