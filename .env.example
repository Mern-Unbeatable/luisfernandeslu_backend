# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"

# JWT access token (login / protected APIs)
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=10m

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Socket.IO (live quote chat) — same origin as API, path /socket.io
# Client: io(API_URL, { auth: { token: accessToken } })

# Social providers (customer & company only) — leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Admin seed (pnpm seed:admin)
ADMIN_EMAIL=admin@construpreco.local
ADMIN_PASSWORD=AdminDemo123!
ADMIN_NAME=Platform Admin

# SMTP Configuration (Gmail: host must be smtp.gmail.com + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# AI product copy (USE AI buttons)
# Prefer OpenRouter for free/dev models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Optional paid OpenAI (used only if OPENROUTER_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cart / checkout totals
CART_SHIPPING_FEE=20
CART_VAT_FIXED=4
CART_CURRENCY=EUR

# Payment provider: mock (no EuPago) | eupago (real split)
# mock → POST /api/checkout/:id/pay to confirm payment
# eupago → needs EUPAGO_API_KEY + EUPAGO_ADMIN_EXTERN_KEY + seller eupagoExternKey
PAYMENT_PROVIDER=mock

# EuPago Split Payments (used when PAYMENT_PROVIDER=eupago)
EUPAGO_API_KEY=
EUPAGO_BASE_URL=https://sandbox.eupago.pt/api
EUPAGO_ADMIN_EXTERN_KEY=
EUPAGO_CALLBACK_URL=http://localhost:8080/api/checkout/webhook/eupago
EUPAGO_WEBHOOK_SECRET=
ADMIN_COMMISSION_PERCENT=20
EUPAGO_LANG=PT
